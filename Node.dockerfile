# 1. Используем стабильный и легкий образ Node.js
FROM node:20-slim

# 2. Создаем рабочую директорию
WORKDIR /app

# 3. Безопасность: Создаем непривилегированного пользователя
# Мы не хотим, чтобы сторонний код мог что-то сломать в контейнере
RUN groupadd -r executor && useradd -r -g executor executor

# 4. Настраиваем права доступа
RUN chown executor:executor /app

# 5. Переключаемся на этого пользователя
USER executor

# 6. (ВАЖНО) Указываем точку входа, чтобы контейнер понимал, что он — исполнитель JS
# Это гарантирует, что среда Node.js будет инициализирована правильно
CMD ["node"]